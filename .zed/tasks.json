[
    {
        "label": "Build",
        "command": "make",
        "args": ["all"],
        "allow_concurrent_runs": false,
        "use_new_terminal": false
    },
    {
        "label": "Test",
        "command": "make",
        "args": ["test"],
        "allow_concurrent_runs": false,
        "use_new_terminal": false
    },
    {
        "label": "Verify",
        "command": "make",
        "args": ["verify"],
        "allow_concurrent_runs": false,
        "use_new_terminal": false
    },
    {
        "label": "Verify Hard",
        "command": "sudo",
        "args": ["act"],
        "allow_concurrent_runs": false,
        "use_new_terminal": false
    },
    {
        "label": "Run",
        "command": "make && ./build/gbemu -r test.gb",
        "allow_concurrent_runs": false,
        "use_new_terminal": true
    }
]
